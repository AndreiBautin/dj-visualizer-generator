FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:0d99ebf1ccad15037b5c98c9fe8979d6b8dbac23812feae2277a0b277b5c5ffa AS build
WORKDIR /src
COPY backend/ .
RUN dotnet publish src/Worker/DjVisualizer.Worker.csproj -c Release -o /app --no-self-contained

FROM mcr.microsoft.com/dotnet/runtime:9.0@sha256:f0498f092ee240bb91f802b157054dc42c98d6fd6a853ba17e76965c555a9262
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app .
COPY assets/fonts/*.ttf fonts/
ENTRYPOINT ["dotnet", "DjVisualizer.Worker.dll"]
