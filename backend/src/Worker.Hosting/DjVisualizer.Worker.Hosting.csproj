<Project Sdk="Microsoft.NET.Sdk">

  <!-- The render worker's hosted services as a library rather than part of the Worker executable,
       so both composition roots can host them: the standalone Worker process (docker-compose) and
       the API process (single-container hosting). A library also has no appsettings.json of its
       own, which is what keeps the two entry points' configuration files from colliding when the
       Api publishes. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DjVisualizer.Worker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\DjVisualizer.Infrastructure.csproj" />
    <ProjectReference Include="..\Application\DjVisualizer.Application.csproj" />
    <ProjectReference Include="..\Domain\DjVisualizer.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DjVisualizer.Worker.Tests" />
  </ItemGroup>

</Project>
