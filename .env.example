# Copy to .env and adjust. Consumed by docker-compose.yml.
#
# There are no secrets in this file, and there are none in the application: it has no database,
# no auth and no third-party services. If that ever changes, note that .env is gitignored and
# .env.example (this file) is committed - never put a real credential here.

# --- Runtime ---------------------------------------------------------------------------------
# Development or Production. Development additionally exposes the OpenAPI document at /openapi.
ASPNETCORE_ENVIRONMENT=Production

# --- Upload limits (Domain.Uploads.UploadLimits) ----------------------------------------------
# These are the self-hosted defaults, sized for real hardware. The free-tier demo overrides them
# with far smaller values in render.yaml - see docs/DEPLOYMENT.md.
#
# A malformed value here does NOT crash the app: Api/Configuration/JobsOptionsFactory logs a
# warning and falls back to the documented default. Non-positive values are rejected the same way.
MAX_AUDIO_BYTES=2147483648      # 2 GB
MAX_IMAGE_BYTES=26214400        # 25 MB
MAX_DURATION_SECONDS=21600      # 6 hours

# Minimum free disk required to accept a new job. Below this, POST /jobs returns 503 and /health
# reports Degraded. The 3 GB default is a safety margin above one worst-case upload; a small cloud
# instance needs this lowered or it will refuse every job.
MIN_FREE_DISK_BYTES=3221225472  # 3 GB

# ==============================================================================================
# Variables below are NOT used by docker-compose. They are listed because they are the complete
# set the application reads, and a deployment that isn't compose (see render.yaml) needs them.
# ==============================================================================================

# --- Jobs ------------------------------------------------------------------------------------
# Absolute path to the shared jobs directory. The Api and Worker MUST agree on this - they
# communicate through it, and their built-in fallbacks are different directories.
# Jobs__RootPath=/data/jobs

# Single-container hosting: the Api additionally hosts the render worker's background services in
# its own process and serves the built SPA from wwwroot. Leave false for docker-compose, where the
# Worker is its own container and nginx serves the SPA. Accepts true/false/1/0/yes/no/on/off; an
# unrecognised value falls back to false and logs a warning rather than being guessed at.
# Jobs__SingleContainer=false

# --- Demo ------------------------------------------------------------------------------------
# Enables POST /jobs/sample, which renders the bundled synthesized sample mix so a visitor can try
# the app without uploading anything. Off by default so a private instance doesn't silently grow a
# public endpoint. See docs/DEMO_DATA.md.
# Demo__Enabled=false
# Demo__AudioFilePath=demo/sample-mix.mp3      # relative paths resolve against the content root
# Demo__ArtworkFilePath=demo/sample-artwork.png
# Demo__Title=Sample Demo Mix

# --- Worker ----------------------------------------------------------------------------------
# Font files used for the video caption. The defaults are the in-container paths populated by the
# Dockerfiles from assets/fonts/. On a Windows dev machine these must point at real .ttf files or
# ffmpeg's drawtext fails - run.bat sets them automatically.
# Worker__FontFilePathSansBold=/app/fonts/Poppins-ExtraBold.ttf
# Worker__FontFilePathSerifBold=/app/fonts/AbrilFatface-Regular.ttf
# Worker__FontFilePathMonoBold=/app/fonts/SpaceMono-Bold.ttf

# libx264 preset. Only ~60 frames are ever encoded (the rest of the video is a stream copy of that
# loop), so this trades very little quality for encode speed. "ultrafast" on constrained hosting.
# Worker__X264Preset=veryfast

# "libx264" (portable, works everywhere including CI with no GPU) or "h264_nvenc" (NVIDIA hardware
# encoding - needs a compatible GPU and driver on the machine running the Worker).
# Worker__VideoCodec=libx264

# Worker__PollingIntervalSeconds=3
# Worker__CleanupIntervalSeconds=300
# Worker__RetentionMinutes=60          # completed/failed jobs are deleted after this
# Worker__StaleProcessingMinutes=60    # jobs stuck Processing this long are failed and recovered

# --- Ops ingest (Incident Intelligence) --------------------------------------------------------
# Opt-in. Empty URL or empty key = no-op sink. A down Incident Intelligence box never fails a job.
# Generate one long random string. Set it here AND as Ingest__ApiKey on incident-api.
# Ops__IncidentBrainUrl=https://incident-api.onrender.com
# Ops__IngestKey=
# Ops__Service=dj-worker

# --- Frontend build-time variables -------------------------------------------------------------
# IMPORTANT: Vite compiles every VITE_-prefixed variable into the public JavaScript bundle. They
# are readable by anyone who loads the page. NEVER put a credential behind a VITE_ prefix.
#
# Where the SPA sends API requests. "/api" for docker-compose (nginx proxies that prefix); the
# EMPTY STRING for single-container hosting, where the API serves the bundle from its own origin
# and its routes are at /jobs. Leaving it unset defaults to "/api".
# VITE_API_BASE_URL=/api

# Shows the "Render a sample mix" button. Should match the server's Demo__Enabled - if they
# disagree the button appears and the server answers 404, which the UI surfaces as an error.
# VITE_SAMPLE_ENABLED=false

# Commit SHA injected at build time so a deployed page can be tied back to a commit.
# VITE_BUILD_SHA=unknown
