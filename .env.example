# Copy to .env and adjust as needed. Consumed by docker-compose.yml.

# ASP.NET Core / .NET environment name (Development, Production)
ASPNETCORE_ENVIRONMENT=Production

# Upload limits (see Domain.Uploads.UploadLimits)
MAX_AUDIO_BYTES=2147483648
MAX_IMAGE_BYTES=26214400
MAX_DURATION_SECONDS=21600

# Minimum free disk space (bytes) required to accept a new job; below this, POST /jobs
# returns 503 and /health reports Degraded.
MIN_FREE_DISK_BYTES=3221225472
